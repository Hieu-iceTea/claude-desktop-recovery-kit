#!/usr/bin/env bash
# =============================================================================
# claude-history  (v3.3.0) — MỘT lệnh gốc cho toàn bộ kit
#
# KHÔNG có đuôi .sh là CỐ Ý — theo Google Shell Style Guide: file thực thi mà
# người dùng gọi trực tiếp thì KHÔNG nên có đuôi (không cần biết nó viết bằng
# ngôn ngữ gì để chạy); chỉ THƯ VIỆN mới bắt buộc có đuôi .sh. Các script bên
# dưới giữ .sh vì nay chúng đóng vai trò phần thực thi nội bộ.
#
# VÌ SAO CÓ FILE NÀY:
#   Đo từ ~/.zsh_history (1425 dòng): 3 script chiếm ~90% lượt dùng
#     repair-missing-sessions 132 · status 53 · safe-quit 44
#   còn 2 script CHƯA TỪNG chạy lần nào. Người dùng phải nhớ 14 script, 17 cờ,
#   7 alias để làm 5 việc — và đã hỏi "tôi nên làm gì tiếp theo?" 5 lần.
#
# THIẾT KẾ: dispatcher MỎNG. KHÔNG viết lại script nào — chỉ định tuyến và
#   truyền tham số. Viết lại mã đang chạy đúng là cách nhanh nhất để sinh lỗi mới.
#   (clig.dev quan tâm GIAO DIỆN một lệnh gốc, không bắt hợp nhất mã bên dưới.)
#
# NGUYÊN TẮC: ĐỌC thì chạy bao nhiêu cũng được. GHI thì chỉ khi ĐÃ THẤY thiếu.
#   Mọi lệnh sửa đều mặc định XEM TRƯỚC; phải thêm --apply mới ghi.
#
# QUY ƯỚC: mọi định danh (biến, hàm, lệnh con) bằng TIẾNG ANH theo chuẩn kỹ
#          thuật; mọi thứ HIỂN THỊ cho người đọc bằng TIẾNG VIỆT CÓ DẤU.
# =============================================================================
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VER="$(cat "$HERE/../VERSION" 2>/dev/null || echo '?')"

STATUS="$HERE/status.sh"
QUIT="$HERE/safe-quit.sh"
STORE="$HERE/store.sh"
REPAIR="$HERE/repair-missing-sessions.sh"
LOST="$HERE/restore-lost-entries.sh"
DEDUP="$HERE/dedup-entries.sh"
MERGE="$HERE/merge-branches.sh"
FIXALL="$HERE/fix-all.sh"
VERIFY="$HERE/verify-entries.sh"
ACTIVITY="$HERE/fix-activity.sh"
UNIFY="$HERE/setup-unified-sessions.sh"
UNROLL="$HERE/rollback-unified-sessions.sh"

usage() {
  cat <<EOF
claude-history v$VER — giữ lịch sử Claude Desktop không bị mất

  KHI THẤY THIẾU — 3 bước
    claude-history quit          1. Thoát Claude an toàn
    claude-history fix --apply   2. Khôi phục TẤT CẢ: danh sách + nội dung
    open -a Claude               3. Mở lại, làm việc tiếp

  XEM TRƯỚC (an toàn, chỉ đọc, chạy khi Claude đang mở)
    claude-history check         Thiếu những gì
    claude-history fix           Sẽ sửa những gì, chưa ghi

  HẰNG NGÀY
    claude-history save          Lưu một bản vào kho git
    claude-history verify-entries  ĐO xem có thiếu tin nhắn mới nhất không

  Tất cả lệnh:  claude-history help all
EOF
}

usage_all() {
  usage
  cat <<EOF

  ─── SỬA LẺ (mặc định xem trước, thêm --apply để ghi) ───
    fix --list-only              Chỉ DANH SÁCH (hội thoại mất khỏi Recents)
    fix --content-only           Chỉ NỘI DUNG  (mở ra thiếu tin nhắn)
    fix lost                     Hội thoại không còn mục nào
    fix orphan                   Phiên có nội dung nhưng chưa có mục
    fix dup                      Nhiều mục cùng trỏ vào một hội thoại
    fix stale                    Đổi con trỏ mục — ⚠️ là ĐÁNH ĐỔI, hiếm khi cần

  ─── HỢP NHẤT NỘI DUNG (một hội thoại) ───
    merge --list                 Hội thoại nào đang thiếu nội dung
    merge --id <mã> --apply --point
                                 Gộp rồi trỏ mục — cần thoát Claude trước
    merge --id <mã> --apply --point --since 2026-07-01 --until 2026-07-31
                                 Gộp theo giai đoạn, cho hội thoại quá lớn

  ─── KHO GIT (~/DATA/claude-store) ───
    verify                       Kiểm tra toàn vẹn kho
    log                          Lịch sử các bản đã lưu
    restore <bản> <đường-dẫn>    Lấy một file ra (KHÔNG ghi đè bản sống)
    compact                      Nén sâu (~8 phút, ăn CPU)

  ─── TÀI KHOẢN & TEAM ───  (lý do bộ kit này ra đời)
    unify                        Xem team nào chưa dùng chung danh sách
    unify --apply                Gộp + trỏ symlink về danh sách chung
    unify --rollback <thư-mục>   Hoàn tác một lần unify --apply

    Claude Desktop vốn cho MỖI tài khoản/team một thư mục danh sách RIÊNG —
    đăng xuất rồi đăng nhập tài khoản khác là mất sạch danh sách cũ.
    Lệnh unify trỏ mọi thư mục đó về MỘT danh sách chung nên không mất nữa.
    Chạy lại sau khi: thêm tài khoản · thêm team · Claude Desktop cập nhật.

  ─── DỌN ───
    verify-entries               ĐO xem có thiếu tin nhắn mới nhất không
    forget <mã>                  Gỡ mục VĨNH VIỄN (fix sẽ không tạo lại)
    fix-activity                 Kéo mục chìm đáy danh sách lên đúng chỗ

  ─── KHÁC ───
    status                       Báo cáo trạng thái 4 lớp
    quit --reopen                Thoát rồi mở lại luôn

  Lệnh ghi đòi Claude Desktop đã tắt — script tự chặn nếu app đang mở.
EOF
}


CMD="${1:-help}"; shift 2>/dev/null || true

case "$CMD" in

  save)     exec "$STORE" save "$@" ;;
  verify)   exec "$STORE" verify "$@" ;;
  log)      exec "$STORE" log "$@" ;;
  restore)  exec "$STORE" restore "$@" ;;
  compact)  exec "$STORE" compact "$@" ;;

  quit)     exec "$QUIT" "$@" ;;
  status)   exec "$STATUS" "$@" ;;
  verify-entries) exec "$VERIFY" "$@" ;;
  fix-activity)   exec "$ACTIVITY" "$@" ;;

  forget)
    # Gỡ mục VĨNH VIỄN. Gỡ file chỉ mục không thôi thì `fix` tạo lại — sự cố
    # 27/08/2026: mục "⤷ kho gộp" mọc lại sau 1 giờ 17 phút. Phải đặt dấu
    # `deleted_<id>` — cơ chế sẵn có của app (47 file đã tồn tại), và cả
    # restore-lost-entries lẫn repair đều tôn trọng nó.
    SID="${1:-}"
    [ -n "$SID" ] || { echo "⛔ Cần mã phiên: claude-history forget <mã>" >&2; exit 2; }
    SID="$SID" /usr/bin/python3 - <<'PYF'
import json,glob,os,sys,time
D=os.path.expanduser("~/Library/Application Support/Claude/claude-code-sessions-shared")
want=os.environ["SID"]
hits=[]
for f in glob.glob(os.path.join(D,"local_*.json")):
    try: d=json.load(open(f))
    except Exception: continue
    c=d.get("cliSessionId") or ""
    if c.startswith(want): hits.append((f,d,c))
if not hits:
    print(f"⛔ Không thấy mục nào trỏ vào '{want}'."); sys.exit(1)
for f,d,c in hits:
    os.rename(f,f+".removed")
    open(os.path.join(D,"deleted_"+c),"w").write(str(int(time.time()*1000)))
    print(f"  đã gỡ: {d.get('title')}")
    print(f"    dấu deleted_{c[:8]}… — fix/repair sẽ KHÔNG tạo lại")
print("  Transcript trên đĩa VẪN NGUYÊN. Hoàn tác: xoá dấu deleted_, đổi .removed về .json")
PYF
    ;;
  merge)    exec "$MERGE" "$@" ;;
  unify)
    # KHÔNG viết script mới cho việc này. `setup-unified-sessions.sh` (từ v2.0.0,
    # chạy thật 15/06/2026) đã làm đúng và làm nhiều hơn: gộp cả folder team CÓ
    # phiên vào shared trước khi trỏ symlink, backup kèm MANIFEST + status-before
    # + layout-before vào recovery-data, hoãn folder đang hoạt động xuống cuối,
    # và có rollback đi kèm.
    case "${1:-}" in
      --rollback) shift; exec "$UNROLL" "$@" ;;
      *)          exec "$UNIFY" "$@" ;;
    esac ;;

  check)
    # Chỉ ĐỌC. Chạy cả 5 phép rồi in ra lệnh cần chạy — thay cho việc người dùng
    # phải nhớ script nào lo chiều nào.
    echo "🔎 Kiểm tra 6 chiều (chỉ đọc, không ghi gì)"
    echo
    n_lost="$("$LOST"     2>/dev/null | sed -n 's/^Sẽ tạo \([0-9]*\) mục.*/\1/p')"
    n_dup="$("$DEDUP"     2>/dev/null | sed -n 's/^Dọn \([0-9]*\) mục.*/\1/p')"
    n_orphan="$("$REPAIR" 2>/dev/null | sed -n 's/^Sẽ đưa lại \([0-9]*\) hội thoại.*/\1/p')"
    n_stale="$("$REPAIR" --fix-stale 2>/dev/null | grep -c '^\[[0-9]')"
    n_merge="$("$MERGE" --list 2>/dev/null | sed -n 's/^🧩 Chuỗi cần HỢP NHẤT: \([0-9]*\).*/\1/p')"
    for name in n_lost n_dup n_orphan n_stale n_merge; do
      eval "[ -n \"\${$name:-}\" ] || $name=0"
    done
    printf "  ① hội thoại mất hẳn khỏi danh sách : %s\n" "$n_lost"
    printf "  ② mục trùng                        : %s\n" "$n_dup"
    printf "  ③ phiên chưa có mục nào            : %s\n" "$n_orphan"
    printf "  ④ mục mở bản chưa đủ nội dung      : %s\n" "$n_stale"
    printf "  ⑤ hội thoại có nhánh chưa gộp      : %s\n" "$n_merge"
    echo
    todo=0
    [ "$n_lost"   = 0 ] || { echo "  ⚠️  claude-history fix lost      (rồi thêm --apply)"; todo=1; }
    [ "$n_dup"    = 0 ] || { echo "  ⚠️  claude-history fix dup       (rồi thêm --apply)"; todo=1; }
    [ "$n_orphan" = 0 ] || { echo "  ⚠️  claude-history fix orphan    (rồi thêm --apply)"; todo=1; }
    if [ "$todo" = 0 ]; then
      echo "  ✅ Danh sách đủ và sạch."
    fi
    # ④ và ⑤ KHÔNG phải hỏng hóc — cho nên không báo ⚠️, chỉ nhắc khi > 0.
    [ "$n_stale" = 0 ] || echo "  ℹ️  ④ là ĐÁNH ĐỔI, không phải hỏng. Không đụng gì cũng không mất thêm."
    [ "$n_merge" = 0 ] || echo "  ℹ️  ⑤ xem: claude-history merge --list"
    # ⑥ gần như miễn phí (một lệnh find trên vài thư mục) nên để chung ở đây.
    # Nó trả lời câu "đổi tài khoản/team thì mất danh sách không" mà không phải
    # đợi tới lúc đổi mới biết.
    n_team="$("$UNIFY" --dry-run 2>/dev/null | grep -c '^   \[rank ' || true)"
    [ -n "${n_team:-}" ] || n_team=0
    printf "\n  ⑥ team chưa dùng chung danh sách  : %s\n" "$n_team"
    [ "$n_team" = 0 ] || echo "  ⚠️  claude-history unify         (rồi thêm --apply)"
    ;;

  fix)
    what="${1:-}"
    case "$what" in
      ""|--apply|--dry-run|--list-only|--content-only)
        exec "$FIXALL" "$@" ;;
    esac
    shift 2>/dev/null || true
    case "$what" in
      lost)   exec "$LOST"   "$@" ;;
      dup)    exec "$DEDUP"  "$@" ;;
      orphan) exec "$REPAIR" "$@" ;;
      stale)  exec "$REPAIR" --fix-stale "$@" ;;
      --help|-h)
        exec "$FIXALL" --help ;;
      __never__)
        echo "claude-history fix <việc>   — mặc định XEM TRƯỚC, thêm --apply để thực thi"
        echo
        echo "  lost     Hội thoại KHÔNG CÒN MỤC NÀO trong danh sách"
        echo "  dup      Nhiều mục cùng trỏ vào một hội thoại"
        echo "  orphan   Phiên có nội dung nhưng chưa có mục nào"
        echo "  stale    Mục đang mở bản chưa đủ nội dung  (⚠️ là ĐÁNH ĐỔI)"
        echo
        echo "  Chưa biết cần cái nào?  claude-history check"
        exit 0 ;;
      *)
        echo "⛔ Không có việc '$what'." >&2
        echo "   Có: lost · dup · orphan · stale" >&2
        exit 2 ;;
    esac ;;

  help)
    case "${1:-}" in
      all|--all) usage_all ;;
      *) usage ;;
    esac ;;
  -h|--help) usage ;;
  -V|--version)   echo "claude-history v$VER" ;;

  *)
    echo "⛔ Không có lệnh '$CMD'." >&2
    echo >&2
    usage >&2
    exit 2 ;;
esac
